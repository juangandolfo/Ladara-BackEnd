{
        "compilerOptions": {
          "outDir": "./dist",
          "rootDir": "./",
          "module": "nodenext",
          "target": "esnext",
          "types": [
            "node",
            "express"
          ],
          "typeRoots": [
            "./node_modules/@types",
            "./src/types"
          ],
          "sourceMap": true,
          "strict": true,
          "emitDecoratorMetadata": true,
          "experimentalDecorators": true,
          "skipLibCheck": true,
          "strictPropertyInitialization": false
        },
        "include": [
          "src/**/*",
          "db/migrations/**/*"
        ],
        "files": [
          "src/types/express.d.ts"
        ]
      }